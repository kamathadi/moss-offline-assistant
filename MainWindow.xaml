<Window x:Class="Moss.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moss Settings" Height="820" Width="1180" MinHeight="700" MinWidth="960"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Icon="pack://application:,,,/Assets/Moss.ico"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#202923" BorderThickness="0,0,1,0">
      <Grid Margin="22,24,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Viewbox Width="34" Height="34" VerticalAlignment="Center">
            <Canvas Width="32" Height="32">
              <Path Data="M16,28 C16,21 16,14 16,4 M16,18 C9,18 5,14 4,8 C10,7 15,10 16,18 M16,25 C23,25 27,21 28,15 C22,14 17,18 16,25"
                    Stroke="{StaticResource Accent}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
            </Canvas>
          </Viewbox>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Moss" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="PRIVATE WRITING TOOLS" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,42,0,0">
          <Border Background="#19251C" BorderBrush="#314836" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock Text="RUNNING QUIETLY" FontSize="10" FontWeight="SemiBold" Foreground="#C9EAC9" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Text="YOUR WORKSPACE" FontSize="9" Foreground="#748178" FontWeight="SemiBold" Margin="3,0,0,12"/>
          <Border Background="#182019" BorderBrush="#2C3D30" BorderThickness="1" CornerRadius="9" Padding="12,11">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" FontSize="15" Foreground="{StaticResource Accent}" Margin="0,0,11,0"/>
              <TextBlock Text="Preferences" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="#121914" BorderBrush="#26342A" BorderThickness="1" CornerRadius="12" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
              <Viewbox Width="19" Height="19" Margin="0,0,8,0">
                <Canvas Width="32" Height="32">
                  <Path Data="M16,28 C16,21 16,14 16,4 M16,18 C9,18 5,14 4,8 C10,7 15,10 16,18 M16,25 C23,25 27,21 28,15 C22,14 17,18 16,25"
                        Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="MossAI" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Your writing stays on this laptop. Moss saves your settings, never your text." TextWrapping="Wrap" FontSize="11" Foreground="#AAB8AD" LineHeight="17"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="820" HorizontalAlignment="Left" Margin="48,38,48,42">
        <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Moss stays in the background." FontSize="31" FontWeight="SemiBold" Margin="0,9,0,0"/>
        <TextBlock Text="Choose the tools you want. Use a shortcut anywhere, or right-click selected text to open the Moss menu." TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Muted}" Margin="0,9,0,25"/>

        <Border Background="#14251A" BorderBrush="#3E6443" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,27">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="30" Height="30" VerticalAlignment="Top" Margin="0,1,12,0">
              <Canvas Width="32" Height="32">
                <Path Data="M16,28 C16,21 16,14 16,4 M16,18 C9,18 5,14 4,8 C10,7 15,10 16,18 M16,25 C23,25 27,21 28,15 C22,14 17,18 16,25"
                      Stroke="{StaticResource Accent}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
              </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1">
              <TextBlock Text="PRIVATE. EVEN WITH WI-FI OFF." FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
              <TextBlock Text="Moss is a small writing helper on your laptop. It summarizes, fixes spelling and grammar, suggests words, and rephrases text you select. The text stays on this computer: Moss does not send it to the internet or save it. After installation, you can turn Wi-Fi off and keep using it." TextWrapping="Wrap" FontSize="13" Foreground="#D7E5D9" LineHeight="20" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="Writing tools" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="  ON THIS LAPTOP" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,3,0,0"/>
        </StackPanel>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Summarize" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Shorten selected text and keep the main point." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,11"/>
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="SummarizeBinding" Text="Ctrl + Alt + Space" FontSize="11" Foreground="#D7E4D9" VerticalAlignment="Center"/><Button Content="Set shortcut" Tag="summarize" Click="ShortcutCapture_Click" FontSize="11" Padding="10,6" Margin="13,0,0,0"/></StackPanel>
            </StackPanel>
            <CheckBox x:Name="SummarizeToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Spelling &amp; grammar" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Find likely mistakes in selected text and review a fix." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,11"/>
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="ProofreadBinding" Text="Ctrl + Alt + G" FontSize="11" Foreground="#D7E4D9" VerticalAlignment="Center"/><Button Content="Set shortcut" Tag="proofread" Click="ShortcutCapture_Click" FontSize="11" Padding="10,6" Margin="13,0,0,0"/></StackPanel>
            </StackPanel>
            <CheckBox x:Name="ProofreadToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Better words" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Explore clearer or more fitting word choices." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,11"/>
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="WordsBinding" Text="Ctrl + Alt + W" FontSize="11" Foreground="#D7E4D9" VerticalAlignment="Center"/><Button Content="Set shortcut" Tag="words" Click="ShortcutCapture_Click" FontSize="11" Padding="10,6" Margin="13,0,0,0"/></StackPanel>
            </StackPanel>
            <CheckBox x:Name="WordsToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Rephrase" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Rewrite a sentence while keeping its meaning." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,11"/>
              <StackPanel Orientation="Horizontal"><TextBlock x:Name="RephraseBinding" Text="Ctrl + Alt + R" FontSize="11" Foreground="#D7E4D9" VerticalAlignment="Center"/><Button Content="Set shortcut" Tag="rephrase" Click="ShortcutCapture_Click" FontSize="11" Padding="10,6" Margin="13,0,0,0"/></StackPanel>
            </StackPanel>
            <CheckBox x:Name="RephraseToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Top" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>

        <Border Background="#111713" BorderBrush="#26342A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,3,0,24">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Right-click Moss menu" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="Show enabled writing actions next to selected text when you right-click." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,18,0"/>
            </StackPanel>
            <CheckBox x:Name="ContextMenuToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>

        <TextBlock Text="Shortcuts" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBlock Text="Click Set shortcut beside a feature, then press the key combination you want. Moss registers it globally while running in the background." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,13"/>
        <TextBlock x:Name="SettingsStatus" Text="Settings save automatically." FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,23"/>

        <TextBlock Text="Background" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,11"/>
        <Border Background="#142019" BorderBrush="#314634" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="RuntimeStatus" Text="Starting MossAI on this laptop…" FontSize="11" Foreground="#D7E5D9" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Start Moss when I sign in" FontSize="14" FontWeight="SemiBold"/>
              <TextBlock Text="Moss stays in the system tray. Open Preferences only when you want to change something." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,18,0"/>
            </StackPanel>
            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>
        <Border Background="#111713" BorderBrush="#26342A" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Offer Replace after a suggestion" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="When off, Moss only copies the result; it never changes selected text." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,18,0"/>
            </StackPanel>
            <CheckBox x:Name="ReplaceToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="FeatureSetting_Changed" Unchecked="FeatureSetting_Changed"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
